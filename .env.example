# vision-mcp 配置模板。复制为 .env（与 server.py 同目录）即可生效。
# 配置优先级：config.json > 进程环境变量 > .env 文件 > 默认值

# 可选：后端 API 协议。默认 openai-completions（OpenAI Chat Completions）。
# 可选：openai-responses（OpenAI Responses API）或 anthropic-messages（Anthropic Messages API）
VISION_API=openai-completions

# 必需：视觉后端 API Key（留空时尝试无鉴权端点）
VISION_API_KEY=sk-your-vision-key

# 可选：OpenAI 兼容视觉后端地址（默认阿里云 DashScope）
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 可选：视觉模型名
VISION_MODEL=qwen-vl-plus

# 可选：单次最大输出 token
VISION_MAX_TOKENS=4096

# 可选：请求超时秒数
VISION_TIMEOUT=120

# 可选：瞬时故障（429/5xx/网络抖动）最大重试次数
VISION_MAX_RETRIES=2

# 可选：重试退避基数（秒），第 n 次重试前等待 retry_backoff * 2^n
VISION_RETRY_BACKOFF=2

# 可选：单张图片大小上限（字节），默认 20MB
VISION_MAX_IMAGE_BYTES=20971520

# 可选：图片任一边最大边长 px，超过自动等比缩小（需安装 Pillow）
VISION_MAX_IMAGE_DIMENSION=4000

# 可选：是否自动缩放图片（true/false）
VISION_AUTO_RESIZE=true

# 可选：MCP server 名称
MCP_SERVER_NAME=vision-mcp

# 可选：自定义 .env 文件路径（默认读取与 server.py 同目录的 .env）
# VISION_DOTENV_PATH=C:/path/to/custom.env
